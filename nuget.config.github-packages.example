<?xml version="1.0" encoding="utf-8"?>
<!--
  Consumer nuget.config for installing DBTools from GitHub Packages.
  Copy to your solution directory as nuget.config and authenticate:

    dotnet nuget add source "https://nuget.pkg.github.com/gednt/index.json" \
      --name github \
      --username YOUR_GITHUB_USERNAME \
      --password YOUR_GITHUB_PAT \
      --store-password-in-clear-text

  PAT scopes: read:packages (and repo if the package is private).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="github" value="https://nuget.pkg.github.com/gednt/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="github">
      <package pattern="DBTools" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
